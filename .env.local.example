# Copy this file to .env.local and fill in values

# Required — OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use via OpenRouter (defaults to anthropic/claude-sonnet-4-5)
# Other good options: anthropic/claude-3-haiku, google/gemini-flash-1.5, openai/gpt-4o
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── Ollama (local) ───────────────────────────────────────────────
# Uncomment to use a local Ollama model instead of OpenRouter
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ── Demo mode ────────────────────────────────────────────────────
# Set to "true" to use rule-based mock agent (no API key needed)
# DEMO_MODE=true

# ── Swiggy MCP ───────────────────────────────────────────────────
# Leave blank for mock mode (no Swiggy credentials needed for demo)
SWIGGY_ACCESS_TOKEN=
SWIGGY_BASE_URL=https://mcp-staging.swiggy.com
